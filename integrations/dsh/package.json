{
  "name": "dsh-skill-deterministic-pixel-art",
  "version": "0.1.6",
  "description": "在 DSH 对话中用自然语言创作像素图、修改现有 PNG，导出 PNG 和可编辑 JSON，也可按指定区域改色。 Create and edit pixel art in DSH with natural-language requests; export PNG and editable JSON, or recolor a selected area.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "generated/",
    "skills/",
    "skill-manifest.json",
    "NOTICE.md",
    "README.zh-CN.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chenamel/deterministic-pixel-art.git",
    "directory": "integrations/dsh"
  },
  "homepage": "https://github.com/Chenamel/deterministic-pixel-art/tree/main/integrations/dsh",
  "bugs": {
    "url": "https://github.com/Chenamel/deterministic-pixel-art/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-skill": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.1",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.2-rc.1",
    "semver": "^7.8.5"
  }
}
